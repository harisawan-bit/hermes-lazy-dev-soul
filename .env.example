# =========================================================================
# Hermes Agent Configuration Template (.env.example)
# Rename to .env and insert your real API keys.
# NEVER commit your real .env file.
# =========================================================================

# LLM Provider Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
FIREWORKS_API_KEY=your_fireworks_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection
DEFAULT_MODEL=nousresearch/hermes-3-llama-3.1-405b

# Workspace Configuration
HERMES_WORKSPACE=./workspace
HERMES_USER_FILES=./hermes-user-files

# Telemetry & Logging
HERMES_LOG_LEVEL=INFO
